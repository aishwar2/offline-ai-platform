# =============================================================================
# Offline AI Platform - Environment Configuration Template
# Copy to .env and replace placeholder secrets before running in production.
# =============================================================================

# Application
APP_NAME=Offline AI Platform
APP_ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Security & JWT
JWT_SECRET_KEY=change-this-to-a-long-random-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:80

# Rate Limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# PostgreSQL Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=offline_ai
POSTGRES_USER=offline_ai_user
POSTGRES_PASSWORD=change-this-db-password
DATABASE_URL=postgresql+psycopg2://offline_ai_user:change-this-db-password@postgres:5432/offline_ai

# Ollama AI Runtime (Optimized for 2 CPU / 4 GB RAM, No GPU)
OLLAMA_BASE_URL=http://ollama:11434
DEFAULT_MODEL=tinyllama
AVAILABLE_MODELS=tinyllama,qwen2.5:0.5b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=5m

# Optional Advanced Features (RAG / ChromaDB / MCP)
RAG_ENABLED=true
CHROMA_PERSIST_DIR=/app/data/chroma
MAX_UPLOAD_SIZE_MB=10
MCP_ENABLED=true

# Monitoring
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-grafana-password
